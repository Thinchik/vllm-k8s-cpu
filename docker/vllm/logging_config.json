{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "privacy": {
      "()": "vllm_privacy.logging_filter.PrivacyFilter"
    }
  },
  "formatters": {
    "vllm": {
      "()": "vllm.logging_utils.NewLineFormatter",
      "format": "(%(vllm_process_name)s pid=%(process)d) %(levelname)s %(asctime)s [%(fileinfo)s:%(lineno)d] %(message)s",
      "datefmt": "%m-%d %H:%M:%S",
      "log_level": "INFO"
    }
  },
  "handlers": {
    "vllm": {
      "class": "logging.StreamHandler",
      "formatter": "vllm",
      "filters": ["privacy"],
      "level": "INFO",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "vllm": {
      "handlers": ["vllm"],
      "level": "INFO",
      "propagate": false
    }
  }
}
