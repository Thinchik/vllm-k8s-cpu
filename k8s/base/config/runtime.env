# Переменные окружения для обоих контейнеров пода (initContainer и vLLM).
# Изменение файла -> новый хеш ConfigMap -> kustomize перекатывает Deployment.

MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
MODEL_REVISION=main
MODELS_DIR=/models

# Размер KV-кэша на CPU, ГиБ. Вместе с весами (~3 ГиБ в bf16) должен помещаться в limits.memory
VLLM_CPU_KVCACHE_SPACE=4

# В контейнере с CPU-лимитом автопривязка потоков видит все ядра ноды,
# поэтому отключаем ее и задаем число потоков явно: limits.cpu минус одно ядро под API-сервер
VLLM_CPU_OMP_THREADS_BIND=nobind
OMP_NUM_THREADS=3
