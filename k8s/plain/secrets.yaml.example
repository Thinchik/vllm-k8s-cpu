# Шаблон. Удобнее создать секреты командой из README (kubectl create secret ...), чтобы токены не попадали в файлы
apiVersion: v1
kind: Secret
metadata:
  name: hf-token
  namespace: llm-inference
type: Opaque
stringData:
  HF_TOKEN: ''
---
apiVersion: v1
kind: Secret
metadata:
  name: vllm-api-token
  namespace: llm-inference
type: Opaque
stringData:
  VLLM_API_KEY: change-me
